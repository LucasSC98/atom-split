PORT=3000
NODE_ENV=development

POSTGRES_USER=fintech
POSTGRES_PASSWORD=fintech_secret
POSTGRES_DB=split_payments
POSTGRES_PORT=5432

# Banco principal de desenvolvimento
DATABASE_URL="postgresql://fintech:fintech_secret@localhost:5432/split_payments?schema=public"

# Em .env.test, aponte obrigatoriamente para um banco terminando em _test:
# DATABASE_URL="postgresql://fintech:fintech_secret@localhost:5432/split_payments_test?schema=public"
