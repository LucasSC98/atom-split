PORT=3000
NODE_ENV=development

POSTGRES_USER=fintech
POSTGRES_PASSWORD=fintech_secret
POSTGRES_DB=split_payments
POSTGRES_PORT=5432

# Banco principal de desenvolvimento (em produção na Neon: URL com pooler -pooler)
DATABASE_URL="postgresql://fintech:fintech_secret@localhost:5432/split_payments?schema=public"
# URL direta sem pooler usada pelo Prisma Migrate (localmente igual à DATABASE_URL)
DIRECT_URL="postgresql://fintech:fintech_secret@localhost:5432/split_payments?schema=public"

# Origens permitidas no CORS em produção (separadas por vírgula)
# CORS_ORIGIN="https://seu-painel.onrender.com,https://seu-dominio.com"

# Em .env.test, aponte obrigatoriamente para um banco terminando em _test:
# DATABASE_URL="postgresql://fintech:fintech_secret@localhost:5432/split_payments_test?schema=public"
# DIRECT_URL="postgresql://fintech:fintech_secret@localhost:5432/split_payments_test?schema=public"
