{
  "name": "marketplace-payment-split-api",
  "version": "1.0.0",
  "description": "API RESTful de Split de Pagamentos para Marketplaces com Ledger Imutável e Idempotência",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc",
    "build:render": "prisma generate && tsc",
    "build:web": "npm --prefix web run build",
    "start": "node dist/server.js",
    "start:render": "prisma migrate deploy && node dist/server.js",
    "test:db:prepare": "ts-node -e \"require('dotenv').config({ path: '.env.test', override: true }); if (!process.env.DATABASE_URL || !new URL(process.env.DATABASE_URL).pathname.endsWith('_test')) { throw new Error('DATABASE_URL must end with _test'); } require('child_process').execSync('npx prisma migrate deploy', { stdio: 'inherit', env: process.env });\"",
    "test": "npm run test:db:prepare && jest --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
